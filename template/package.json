{
  "name": "electron-app",
  "productName": "Electron App",
  "version": "0.1.0",
  "private": true,
  "description": "An Electron application built with Electron AppStack",
  "author": "Your Name",
  "homepage": "https://github.com/your-org/electron-app",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node scripts/db-reset.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^12.0.0",
    "electron-vite": "^6.0.0",
    "i18next": "^26.5.4",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "trpc-electron": "^0.1.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "electron-winstaller": false,
    "esbuild": true,
    "fsevents": true
  }
}
